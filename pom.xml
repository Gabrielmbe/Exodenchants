<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.fce</groupId>
    <artifactId>fabled-custom-enchants</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>FabledCustomEnchants</name>
    <description>Custom Enchants bridge for Fabled 5 (Paper 1.21+ / 26.x)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Paper 1.21 requiere Java 21. Compilar con release 21 tambien
             funciona en servidores 26.x (que corren sobre Java 25). -->
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- Fabled se publica en Maven Central: no necesita repositorio propio -->
        <repository>
            <!-- PlaceholderAPI -->
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- API de Paper (incluye Adventure/MiniMessage: no hay que shadear nada) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Fabled 5 (Maven Central). 1.0.4-R0.56 es la ultima version
             publicada en Central; si tu servidor usa un build mas nuevo
             (ej: 1.0.4-R0.73 de Spigot), instalalo en tu repo local
             (ver README.md, paso 2b) y ajusta esta version. -->
        <dependency>
            <groupId>studio.magemonkey</groupId>
            <artifactId>fabled</artifactId>
            <version>1.0.4-R0.56</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI (placeholders %fce_...%, opcional en runtime) -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vault (economia de la tienda, opcional en runtime) -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>FabledCustomEnchants-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>
</project>
