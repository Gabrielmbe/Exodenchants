<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.fce</groupId>
    <artifactId>ExodeEnchant</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>ExodeEnchant</name>
    <description>Custom Enchants bridge for Fabled 5 (Paper 1.21+ / 26.x)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Paper 1.21 requiere Java 21. Compilar con release 21 tambien
             funciona en servidores 26.x (que corren sobre Java 25). -->
        <maven.compiler.release>21</maven.compiler.release>
        <!-- ProGuard 7.9.1 soporta class files hasta Java 26 (class 70). -->
        <proguard.version>7.9.1</proguard.version>
        <!-- SEGURO POR DEFECTO: la ofuscacion queda DESACTIVADA salvo que el
             entorno sea compatible. El perfil 'ofuscar' (mas abajo) la activa
             automaticamente SOLO cuando:
               1) el JDK es 21 a 26 (rango que ProGuard soporta), y
               2) existe ${java.home}/jmods/java.base.jmod (JDK completo).
             En cualquier otro caso ProGuard se salta solo y el build
             SIEMPRE termina en BUILD SUCCESS con un jar funcional.
             Forzar manualmente:
               - saltar ofuscacion:  mvn clean package -Dproguard.skip=true
               - forzar ofuscacion:  mvn clean package -Dproguard.skip=false -->
        <proguard.skip>true</proguard.skip>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- Fabled se publica en Maven Central: no necesita repositorio propio -->
        <repository>
            <!-- PlaceholderAPI -->
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- API de Paper (incluye Adventure/MiniMessage: no hay que shadear nada) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!--  (Maven Central). 1.0.4-R0.56 es la ultima version
             publicada en Central; si tu servidor usa un build mas nuevo
             (ej: 1.0.4-R0.73 de Spigot), instalalo en tu repo local
             (ver README.md, paso 2b) y ajusta esta version. -->
        <dependency>
            <groupId>studio.magemonkey</groupId>
            <artifactId>Fabled</artifactId>
            <version>1.0.4-R0.56</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI (placeholders %fce_...%, opcional en runtime) -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vault (economia de la tienda, opcional en runtime) -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ExodeEnchant-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- ============================================================
                 ProGuard: ofusca el jar final en la fase package.
                 El jar de target/ sale ya ofuscado con el mismo nombre.
                 El mapa de renombres queda en target/proguard_map.txt:
                 GUARDALO por cada version publicada (sin el, los errores
                 de consola ofuscados son ilegibles).

                 A PRUEBA DE FALLOS:
                 - Solo corre cuando el perfil 'ofuscar' se activa (JDK 21-26
                   con jmods). En JDK 27+, JREs sin jmods o entornos raros se
                   salta automaticamente: el build nunca falla por ProGuard.
                 - MODO TOLERANTE: -ignorewarnings + -dontwarn ** hacen que
                   ninguna advertencia (clases de Paper/Fabled/PAPI/Vault no
                   presentes como library jars, referencias opcionales, etc.)
                   aborte el build.
                 ============================================================ -->
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.7.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                    </execution>
                </executions>
                <!-- Fija la version real de ProGuard que usa el plugin.
                     Sin esta dependencia explicita el plugin puede resolver
                     una version antigua incompatible con JDK 25+. -->
                <dependencies>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>${proguard.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <proguardVersion>${proguard.version}</proguardVersion>
                    <skip>${proguard.skip}</skip>
                    <obfuscate>true</obfuscate>

                    <injar>${project.build.finalName}.jar</injar>
                    <outjar>${project.build.finalName}.jar</outjar>

                    <!-- Runtime de Java para resolver las clases base.
                         El filtro excluye module-info.class y jars internos,
                         que ProGuard no debe procesar.
                         java.logging es necesario porque JavaPlugin#getLogger
                         usa java.util.logging.Logger (modulo java.logging,
                         NO java.base): sin el, ProGuard emite errores de
                         clase no encontrada. -->
                    <libs>
                        <lib>${java.home}/jmods/java.base.jmod(!**.jar;!module-info.class)</lib>
                        <lib>${java.home}/jmods/java.logging.jmod(!**.jar;!module-info.class)</lib>
                    </libs>

                    <options>
                        <option>-dontoptimize</option>
                        <option>-dontpreverify</option>
                        <option>-dontshrink</option>

                        <!-- MODO TOLERANTE: ninguna advertencia aborta el build. -->
                        <option>-ignorewarnings</option>
                        <option>-dontwarn **</option>
                        <option>-dontnote **</option>

                        <!-- Evita colisiones a.class/A.class en filesystems
                             sin distincion de mayusculas (Windows/macOS). -->
                        <option>-dontusemixedcaseclassnames</option>

                        <!-- La clase principal NO puede renombrarse:
                             plugin.yml la referencia por nombre -->
                        <option>-keep public class dev.fce.FabledCustomEnchantsPlugin { *; }</option>

                        <!-- Bukkit localiza los eventos por @EventHandler -->
                        <option>-keepattributes *Annotation*,Signature,Exceptions,InnerClasses,EnclosingMethod,Record,SourceFile,LineNumberTable</option>
                        <option>-keepclassmembers class * { @org.bukkit.event.EventHandler *; }</option>

                        <!-- Enums resueltos por reflexion -->
                        <option>-keepclassmembers enum * { public static **[] values(); public static ** valueOf(java.lang.String); }</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Activa la ofuscacion SOLO en entornos donde ProGuard funciona
             garantizado: JDK 21 a 26 (rango soportado por ProGuard 7.9.x)
             y con los jmods del JDK presentes. Ambas condiciones deben
             cumplirse (Maven 3.2.2+). En cualquier otro entorno el build
             empaqueta el jar sin ofuscar y termina en BUILD SUCCESS. -->
        <profile>
            <id>ofuscar</id>
            <activation>
                <jdk>[21,27)</jdk>
                <file>
                    <exists>${java.home}/jmods/java.base.jmod</exists>
                </file>
            </activation>
            <properties>
                <proguard.skip>false</proguard.skip>
            </properties>
        </profile>
    </profiles>
</project>
